{
  "name": "ShowwcaseXS",
  "version": "1.0.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "permissions": ["tabs", "contextMenus"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; 'https://www.google.com';unsafe-inline; object-src 'self'"
  }
}
